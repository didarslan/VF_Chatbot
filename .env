# === OpenAI ===
OPENAI_API_KEY="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"
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# === Vector backend ===
VECTOR_BACKEND=milvus   # milvus | chroma


# === Chroma (fallback) ===
CHROMA_DIR=./data/indexes/chroma
VECTOR_COLLECTION=vodafone_kb

# === HTTP ===
HTTP_TIMEOUT_S=20
HTTP_MAX_RETRIES=3
HTTP_RATE_LIMIT_RPS=1
USER_AGENT=VodafoneAgenticAssistant/0.1

# === Optional tracing ===
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=Vodafone-Agentic-Assistant
LANGCHAIN_ENDPOINT=https://api.langsmith.ai

ASSISTANT_TONE=friendly   # friendly | formal
ASSISTANT_MAX_SENTENCES=3
ASSISTANT_LANGUAGE=turkish  # turkish | english
ASSISTANT_EXPERTISE=high   # high | medium | low
